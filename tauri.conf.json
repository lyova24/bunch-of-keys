{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bunch-of-keys",
  "version": "0.5.0",
  "identifier": "dev.bunchofkeys.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "bunch-of-keys",
        "width": 520,
        "height": 580,
        "minWidth": 440,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Local encrypted credential manager",
    "longDescription": "A Linux tray utility for managing multiple encrypted, structured credential vaults.",
    "copyright": "Copyright © 2026 bunch-of-keys contributors",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
